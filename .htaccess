# Kegzo
Options -Indexes
ErrorDocument 404 /404.html
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
RewriteEngine On
# One address only: www.kegzo.com -> kegzo.com (keeps Google, Facebook and WhatsApp previews consistent)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
# Addresses without .html open the page (kegzo.com/welcome -> /welcome.html)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI}.html [R=301,L]
# Block source, tooling and docs from public access
RewriteRule ^(src|tools)(/|$) - [F,L]
RewriteRule ^(README\.md|SECRETS-TEMPLATE\.php|package\.json)$ - [F,L]
RewriteRule ^api/(config)\.php$ - [F,L]
# Writer settings files are included by PHP, never opened directly
RewriteRule ^(site-profile|bco-chrome|bco-loader|guides-redirects)\.php$ - [F,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
<FilesMatch "\.(html|css|js|webmanifest|xml|txt)$">
Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
<FilesMatch "^sw\.js$">
Header set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>
<FilesMatch "\.(webp|png|jpg|svg|ico|woff2)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>

<IfModule mod_mime.c>
AddType application/manifest+json .webmanifest
AddType image/webp .webp
AddType font/woff2 .woff2
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/manifest+json text/xml
</IfModule>
